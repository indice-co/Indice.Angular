{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ng-auth": {
      "projectType": "library",
      "root": "projects/ng-auth",
      "sourceRoot": "projects/ng-auth/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ng-auth/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-auth/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-auth/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/ng-auth/src/test.ts",
            "tsConfig": "projects/ng-auth/tsconfig.spec.json",
            "karmaConfig": "projects/ng-auth/karma.conf.js"
          }
        }
      }
    },
    "ng-components": {
      "projectType": "library",
      "root": "projects/ng-components",
      "sourceRoot": "projects/ng-components/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ng-components/tsconfig.lib.json",
            "project": "projects/ng-components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-components/tsconfig.lib.prod.json"
            },
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/ng-components/src/test.ts",
            "tsConfig": "projects/ng-components/tsconfig.spec.json",
            "karmaConfig": "projects/ng-components/karma.conf.js"
          }
        }
      }
    },
    "app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/app",
      "sourceRoot": "projects/app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/app"
            },
            "index": "projects/app/src/index.html",
            "polyfills": [
              "projects/app/src/polyfills.ts"
            ],
            "tsConfig": "projects/app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/app/src/favicon.ico",
              "projects/app/src/assets",
              "projects/app/src/app-settings.manifest.json"
            ],
            "styles": [
              "projects/app/src/styles.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "lodash",
              "lodash/cloneDeep",
              "lodash/merge"
            ],
            "browser": "projects/app/src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "8mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kb",
                  "maximumError": "8kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/app/src/environments/environment.ts",
                  "with": "projects/app/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "preserveSymlinks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "app:build:production"
            },
            "development": {
              "buildTarget": "app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "app:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/app/src/test.ts",
            "polyfills": "projects/app/src/polyfills.ts",
            "tsConfig": "projects/app/tsconfig.spec.json",
            "karmaConfig": "projects/app/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/app/src/favicon.ico",
              "projects/app/src/assets"
            ],
            "styles": [
              "projects/app/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "ng-config": {
      "projectType": "library",
      "root": "projects/ng-config",
      "sourceRoot": "projects/ng-config/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ng-config/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-config/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-config/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/ng-config/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "fbb03e04-4116-41fe-aa03-eeccfcc4151e"
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
